{
	"name": "gmart-portfolio",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"routes": [
    {
      "pattern": "portfolio.garrettmartin.xyz",
      "custom_domain": true
    }
  ]
}
